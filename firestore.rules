rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isOwner() {
      return authEmail() == 'icloud07072010@gmail.com';
    }

    function adminsRef() {
      return /databases/$(database)/documents/config/admins;
    }

    function teachersRef() {
      return /databases/$(database)/documents/config/teachers;
    }

    function adminsExist() {
      return exists(adminsRef());
    }

    function teachersExist() {
      return exists(teachersRef());
    }

    function isAdmin() {
      return signedIn() && (
        isOwner() ||
        (adminsExist()
          && get(adminsRef()).data.emails is list
          && authEmail() in get(adminsRef()).data.emails)
      );
    }

    function isTeacher() {
      return signedIn() && !isAdmin() && teachersExist()
        && get(teachersRef()).data.emails is list
        && authEmail() in get(teachersRef()).data.emails;
    }

    function isStaff() {
      return isAdmin() || isTeacher();
    }

    function sameUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validRole(role) {
      return role in ['admin', 'teacher', 'student'];
    }

    function validStaffRole(role) {
      return (role == 'admin' && isAdmin())
        || (role == 'teacher' && isTeacher())
        || (role == 'student' && !isAdmin() && !isTeacher());
    }

    // ------------------------------------------------------------------
    // CONFIG
    // ------------------------------------------------------------------
    // Roles are determined by reading these documents on login, so every
    // authenticated user must be able to read them.
    match /config/admins {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /config/teachers {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /config/roster {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // USER PROFILE
    // ------------------------------------------------------------------
    match /users/{uid} {
      allow read: if sameUser(uid) || isStaff();

      // Client-created profiles can only start as students. Admin/teacher
      // profiles are assigned by the allowlists above, not by user input.
      allow create: if sameUser(uid)
        && request.resource.data.role == 'student'
        && request.resource.data.email == authEmail()
        && request.resource.data.name is string
        && request.resource.data.className is string;

      // Staff may update profiles, but cannot change the Auth email.
      allow update: if isAdmin()
        && request.resource.data.email == resource.data.email
        && validRole(request.resource.data.role);

      // A user may update only the explicitly allowed profile/progress fields.
      // role can change only to the role actually granted by the allowlists.
      // rosterId is the one-time exception used by roster.js when binding a
      // previously unbound student to a real roster entry.
      allow update: if sameUser(uid)
        && request.resource.data.email == resource.data.email
        && validRole(request.resource.data.role)
        && (
          request.resource.data.role == resource.data.role
          || validStaffRole(request.resource.data.role)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'className',
          'streak',
          'lastCompletedDate',
          'totalSetsCompleted',
          'totalBonusPoints',
          'lastLoginAt',
          'role',
          'rosterId'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rosterId'])
          || (
            !(resource.data.rosterId is string)
            && request.resource.data.rosterId is string
            && exists(/databases/$(database)/documents/users_by_roster/$(request.resource.data.rosterId))
            && getAfter(/databases/$(database)/documents/users_by_roster/$(request.resource.data.rosterId)).data.uid == uid
          )
        );

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // ROSTER ↔ UID MAPPING
    // ------------------------------------------------------------------
    match /users_by_roster/{rosterId} {
      // The app reads a mapping to verify that the selected roster entry
      // belongs to the current account.
      allow read: if signedIn();

      // First binding: only the authenticated account can claim an unused
      // roster entry, and the submitted UID/email must be its own.
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/users_by_roster/$(rosterId))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rosterId == rosterId
        && request.resource.data.email == authEmail()
        && request.resource.data.name is string;

      // Admins/teachers can repair mappings. A student can update only their
      // own mapping and cannot move it to another roster ID or UID.
      allow update: if isStaff()
        || (
          signedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.rosterId == resource.data.rosterId
          && request.resource.data.email == authEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name'])
        );

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------------
    // PUBLIC LEARNING CONTENT (authenticated read, staff write)
    // ------------------------------------------------------------------
    match /knowledge/{knowledgeId} {
      allow read: if signedIn() && resource.data.published == true;
      allow read, write: if isStaff();
    }

    match /questionBank/{questionId} {
      allow read: if signedIn() && resource.data.published == true;
      allow read, write: if isStaff();
    }

    match /listeningContent/{listeningId} {
      allow read: if signedIn() && resource.data.published == true;
      allow read, write: if isStaff();
    }

    match /sets/{setId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    // ------------------------------------------------------------------
    // DAILY SET SUBMISSIONS
    // ------------------------------------------------------------------
    match /submissions/{submissionId} {
      // Student can read only their own submissions. Staff can read all.
      allow read: if signedIn()
        && (isStaff() || resource.data.uid == request.auth.uid);

      // A student may create a submission for themselves only. Staff are
      // intentionally read-only here.
      allow create: if signedIn()
        && !isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.setId is string
        && request.resource.data.setId.size() > 0
        && submissionId == request.auth.uid + '_' + request.resource.data.date + '_' + request.resource.data.setId
        && request.resource.data.total == 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.passed == (request.resource.data.score >= 15)
        && request.resource.data.bonusPoints is int
        && request.resource.data.bonusPoints >= 0
        && request.resource.data.bonusPoints <= 2
        && request.resource.data.date is string
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0;

      // Submissions are immutable from the client. Admin/teacher only read.
      allow update, delete: if false;
    }

    // ------------------------------------------------------------------
    // PRIVATE NOTES
    // ------------------------------------------------------------------
    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if sameUser(uid);
    }

    // ------------------------------------------------------------------
    // AUXILIARY COLLECTIONS
    // ------------------------------------------------------------------
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /rate_limits/{id} {
      allow read, write: if isAdmin();
    }
  }
}
