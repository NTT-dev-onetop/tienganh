rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isOwnerEmail() {
      return isSignedIn()
        && request.auth.token.email == 'icloud07072010@gmail.com';
    }

    function isAdmin() {
      return isOwnerEmail()
        || (
          isSignedIn()
          && request.auth.token.email in
            get(/databases/$(database)/documents/config/admins).data.emails
        );
    }

    function isTeacher() {
      return !isAdmin()
        && isSignedIn()
        && request.auth.token.email in
          get(/databases/$(database)/documents/config/teachers).data.emails;
    }

    function isStaff() {
      return isAdmin() || isTeacher();
    }

    match /users/{uid} {
      // Hồ sơ: chính chủ hoặc staff.
      allow read: if isOwner(uid) || isStaff();

      // User chỉ được tự tạo hồ sơ của chính mình.
      // Không thể tự tạo role admin/teacher trừ OWNER/admin hợp lệ.
      allow create: if isOwner(uid)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['student', 'teacher', 'admin']
        && (
          request.resource.data.role == 'student'
          || isStaff()
        );

      // Chính chủ chỉ được cập nhật đúng các field cho phép,
      // không được đổi role và email chỉ được bổ sung khi hồ sơ chưa có email.
      allow update: if isOwner(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'className',
          'streak',
          'lastCompletedDate',
          'totalSetsCompleted',
          'totalBonusPoints',
          'lastLoginAt',
          'rosterId',
          'email'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email'])
          || (
            !('email' in resource.data)
            && request.resource.data.email == request.auth.token.email
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rosterId'])
          || (
            !('rosterId' in resource.data)
            && request.resource.data.rosterId is string
            && exists(/databases/$(database)/documents/users_by_roster/$(request.resource.data.rosterId))
            && get(/databases/$(database)/documents/users_by_roster/$(request.resource.data.rosterId)).data.uid == uid
          )
        )
        || isStaff();

      allow delete: if isAdmin();
    }

    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /users_by_roster/{rosterId} {
      // Roster mapping phải đọc được bởi mọi user đã đăng nhập.
      allow read: if isSignedIn();

      // Lần đầu gắn tên: uid phải chính là tài khoản đang đăng nhập.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      // Chủ mapping hoặc staff được sửa.
      allow update: if isStaff()
        || (
          isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
        );

      allow delete: if isAdmin();
    }

    match /config/admins {
      // Roles.js cần đọc allowlist để xác định admin.
      allow read: if isSignedIn();

      // Chỉ OWNER hoặc email đã có trong chính allowlist hiện tại.
      allow create: if isOwnerEmail();
      allow update: if isOwnerEmail()
        || (
          isSignedIn()
          && request.auth.token.email in resource.data.emails
        );
      allow delete: if isOwnerEmail();
    }

    match /config/teachers {
      // Roles.js cần đọc allowlist để xác định teacher.
      allow read: if isSignedIn();

      // Chỉ OWNER hoặc email đã có trong chính allowlist hiện tại.
      allow create: if isOwnerEmail();
      allow update: if isOwnerEmail()
        || (
          isSignedIn()
          && request.auth.token.email in resource.data.emails
        );
      allow delete: if isOwnerEmail();
    }

    match /config/roster {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /submissions/{submissionId} {
      // Chính chủ hoặc staff.
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isStaff());

      // Chỉ chính chủ tạo submission của chính mình.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && submissionId == request.auth.uid + '_' + request.resource.data.date + '_' + request.resource.data.setId;

      // Không cho HS sửa/xóa submission sau khi tạo.
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /knowledge/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /questionBank/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /listeningContent/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /sets/{setId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // Giữ các collection hiện có của project, không mở rộng quyền.
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /rate_limits/{id} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
