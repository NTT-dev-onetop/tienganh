rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function authEmail() {
      return isSignedIn() ? request.auth.token.email : '';
    }

    function isConfiguredAdminEmail() {
      return isSignedIn()
        && (
          authEmail() == 'icloud07072010@gmail.com'
          || (
            exists(/databases/$(database)/documents/config/admins)
            && authEmail() in get(/databases/$(database)/documents/config/admins).data.emails
          )
        );
    }

    function isConfiguredTeacherEmail() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/config/teachers)
        && authEmail() in get(/databases/$(database)/documents/config/teachers).data.emails;
    }

    function isStaff() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'teacher'];
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userHasUnclaimedRosterFor(rosterId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          !('rosterId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rosterId == ''
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rosterId == rosterId
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rosterId == ('11T1_' + rosterId)
        );
    }

    // =========================================================
    // USERS
    // =========================================================
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();

      // A first-login profile can only bootstrap to the role
      // authorized by the immutable email configuration.
      allow create: if isOwner(uid)
        && request.resource.data.email == authEmail()
        && (
          request.resource.data.role == 'student'
          || (request.resource.data.role == 'teacher' && isConfiguredTeacherEmail())
          || (request.resource.data.role == 'admin' && isConfiguredAdminEmail())
        );

      // Only admins may change another user's profile.
      // An owner may update their own profile fields.
      // Role elevation is permitted ONLY if verified against config/admins or config/teachers.
      // RosterId and className cannot be changed once initially claimed.
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && (
            (request.resource.data.role == resource.data.role && request.resource.data.email == resource.data.email)
            || (request.resource.data.email == authEmail() && request.resource.data.role == 'admin' && isConfiguredAdminEmail())
            || (request.resource.data.email == authEmail() && request.resource.data.role == 'teacher' && isConfiguredTeacherEmail())
          )
          && (
            !('rosterId' in resource.data)
            || resource.data.rosterId == ''
            || (
              request.resource.data.rosterId == resource.data.rosterId
              && (
                !('className' in resource.data)
                || resource.data.className == ''
                || request.resource.data.className == resource.data.className
              )
            )
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'className',
            'rosterId',
            'role',
            'lastLoginAt'
          ])
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // ENGLISH NOTES
    // =========================================================
    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    // =========================================================
    // USERS BY ROSTER
    // =========================================================
    match /users_by_roster/{rosterId} {
      allow read: if isSignedIn();

      allow create: if isStaff()
        || (
          isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.rosterId == rosterId
          && userHasUnclaimedRosterFor(rosterId)
        );

      // A user cannot take over an existing roster mapping.
      allow update: if isStaff()
        || (
          isOwner(request.resource.data.uid)
          && resource.data.uid == request.auth.uid
          && request.resource.data.rosterId == rosterId
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // CONFIG - ADMINS
    // =========================================================
    match /config/admins {
      allow read: if isSignedIn();
      // Teacher must never be able to grant admin to self/others.
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // CONFIG - TEACHERS
    // =========================================================
    match /config/teachers {
      allow read: if isSignedIn();
      // Teacher must never be able to grant/revoke teacher access.
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // CONFIG - ROSTER
    // =========================================================
    match /config/roster {
      allow read: if isSignedIn();
      // Only admins may overwrite or alter class roster.
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // SUBMISSIONS
    // =========================================================
    match /submissions/{submissionId} {
      allow get: if isSignedIn()
        && (
          isStaff()
          || submissionId.matches('^' + request.auth.uid + '_.*')
        );

      allow list: if isSignedIn()
        && (
          isStaff()
          || resource.data.uid == request.auth.uid
        );

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && submissionId == request.auth.uid + '_' + request.resource.data.date + '_' + request.resource.data.setId
        && request.resource.data.setId is string
        && request.resource.data.setId.size() > 0
        && request.resource.data.setId.size() <= 64
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.score is int
        && request.resource.data.total is int
        && request.resource.data.passScore is int
        && request.resource.data.passed is bool
        && request.resource.data.bonusPoints is int
        && request.resource.data.score >= 0
        && request.resource.data.total > 0
        && request.resource.data.score <= request.resource.data.total
        && request.resource.data.passScore > 0
        && request.resource.data.passScore <= request.resource.data.total
        && request.resource.data.bonusPoints >= 0
        && request.resource.data.bonusPoints <= 2
        && request.resource.data.passed == (
          request.resource.data.score >= request.resource.data.passScore
        );

      allow update: if false;
      allow delete: if isAdmin();
    }

    // =========================================================
    // DAILY SETS / CONTENT
    // =========================================================
    match /sets/{setId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /knowledge/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /questionBank/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /listeningContent/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /teacherVocab/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // =========================================================
    // AUDIT
    // =========================================================
    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isStaff()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================
    // RATE LIMITS
    // =========================================================
    match /rate_limits/{id} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
