rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    function bootstrapAdmin() { return false; }
    function isBuilder() { return signedIn() && email() == 'icloud07072010@gmail.com'; }
    function adminConfigExists() { return exists(/databases/$(database)/documents/config/admins); }
    function adminConfig() { return get(/databases/$(database)/documents/config/admins); }
    function isAdmin() {
      return signedIn() && !isBuilder() && (adminConfigExists() && adminConfig().data.emails is list && email() in adminConfig().data.emails);
    }
    function sameUser(uid) { return signedIn() && request.auth.uid == uid; }
    function validRole(role) { return role == 'admin' || role == 'teacher' || role == 'builder' || role == 'student'; }
    function owner() { return signedIn() && email() == 'icloud07072010@gmail.com'; }
    function teacherConfigExists() { return exists(/databases/$(database)/documents/config/teachers); }
    function teacherConfig() { return get(/databases/$(database)/documents/config/teachers); }
    function isTeacher() { return signedIn() && !isAdmin() && teacherConfigExists() && teacherConfig().data.emails is list && email() in teacherConfig().data.emails; }
    function isStaff() { return isAdmin() || isTeacher() || isBuilder(); }

    match /config/admins {
      allow read: if signedIn();
      allow create: if isBuilder() || bootstrapAdmin();
      allow update, delete: if isAdmin() || isBuilder();
    }

    match /config/teachers {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /config/roster {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if sameUser(uid) || isAdmin() || isTeacher() || isBuilder();
      // Người dùng mới luôn được phép tạo hồ sơ của chính mình.
      // Student không phụ thuộc vào config/admins. Admin chỉ được bootstrap bằng Gmail
      // hoặc bằng email đã có trong config/admins.
      allow create: if sameUser(uid)
        && validRole(request.resource.data.role)
        && (
          request.resource.data.role == 'student'
          || (request.resource.data.role == 'builder' && isBuilder())
          || (request.resource.data.role == 'admin' && (isAdmin() || isBuilder()))
          || (request.resource.data.role == 'teacher' && (isAdmin() || isBuilder()))
        );
      allow update: if (
          isAdmin()
          && request.resource.data.email == resource.data.email
          && validRole(request.resource.data.role)
        ) || (
          sameUser(uid)
          && request.resource.data.email == resource.data.email
          && (
            request.resource.data.role == resource.data.role
            || (request.resource.data.role == 'admin' && (isAdmin() || isBuilder()))
            || (request.resource.data.role == 'builder' && isBuilder())
            || (request.resource.data.role == 'teacher' && (isTeacher() || isBuilder()))
            || request.resource.data.role == 'student'
          )
        );
      allow delete: if isAdmin();
    }

    match /users_by_roster/{rosterId} {
      // Cho phép tài khoản đã đăng nhập kiểm tra tên lớp chưa được liên kết.
      // Không thay đổi quyền ghi; chỉ tránh lỗi permission khi getDoc() đọc tài liệu chưa tồn tại.
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rosterId == rosterId
        && !exists(/databases/$(database)/documents/users_by_roster/$(rosterId));
      allow update: if isAdmin() || (sameUser(resource.data.uid) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }


    match /knowledge/{knowledgeId} {
      allow read: if signedIn() && resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /questionBank/{questionId} {
      allow read: if signedIn() && resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /listeningContent/{listeningId} {
      allow read: if signedIn() && resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /sets/{setId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }


    match /teacherTasks/{taskId} {
      allow read: if isBuilder() || isAdmin() || (isTeacher() && resource.data.assignedEmail == email());
      allow create: if isBuilder() || isAdmin();
      allow update: if isBuilder() || isAdmin() || (isTeacher() && resource.data.assignedEmail == email() && request.resource.data.assignedEmail == resource.data.assignedEmail && request.resource.data.status == 'done');
      allow delete: if isBuilder() || isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin() || isTeacher() || isBuilder());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.total == 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.passed == (request.resource.data.score >= 15)
        && request.resource.data.bonusPoints == (request.resource.data.passed ? 2 : 0)
        && request.resource.data.date is string
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0;
      allow update, delete: if isAdmin();
    }

    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if sameUser(uid);
    }

    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /rate_limits/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
