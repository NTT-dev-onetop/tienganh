rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function email() {
      return isSignedIn()
        ? (request.auth.token.email != null
          ? request.auth.token.email.lower()
          : '')
        : '';
    }

    function isTeacherEmail() {
      return isSignedIn()
        && get(/databases/$(database)/documents/config/teachers).data.emails
          .hasAny([email()]);
    }

    function isOwner() {
      return isSignedIn() && email() == 'icloud07072010@gmail.com';
    }

    function isOwnerUid(uid) {
      return isOwner() && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in ['admin', 'teacher'];
    }

    function isAdmin() {
      return isOwner()
        || (isSignedIn()
          && get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == 'admin');
    }

    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      allow read: if isOwnerUid(uid) || isStaff();

      // A normal account can only create itself as student.
      // The owner may bootstrap the single owner account as admin.
      // A configured teacher may create itself as teacher.
      allow create: if isOwnerUid(uid)
        || (
          isSignedIn()
          && uid == request.auth.uid
          && (
            request.resource.data.role == 'student'
            || (request.resource.data.role == 'teacher' && isTeacherEmail())
          )
        );

      allow update: if isAdmin()
        || (
          isOwnerUid(uid)
          && request.resource.data.role == 'admin'
          && request.resource.data.email == resource.data.email
        )
        || (
          isSignedIn()
          && uid == request.auth.uid
          && request.resource.data.role == resource.data.role
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'className',
            'rosterId',
            'lastLoginAt',
            'streak',
            'lastCompletedDate',
            'totalSetsCompleted',
            'totalBonusPoints'
          ])
          // Progress may only move forward by a small, bounded amount.
          && request.resource.data.totalSetsCompleted
              >= resource.data.totalSetsCompleted
          && request.resource.data.totalSetsCompleted
              <= resource.data.totalSetsCompleted + 1
          && request.resource.data.totalBonusPoints
              >= resource.data.totalBonusPoints
          && request.resource.data.totalBonusPoints
              <= resource.data.totalBonusPoints + 2
          && request.resource.data.streak >= 0
          && request.resource.data.streak <= resource.data.streak + 1
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // ENGLISH NOTES
    // =========================================================

    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if isSignedIn() && uid == request.auth.uid;
    }

    // =========================================================
    // USERS BY ROSTER
    // =========================================================

    match /users_by_roster/{rosterId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rosterId == rosterId;

      allow update: if isAdmin()
        || (
          isSignedIn()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.rosterId == rosterId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'uid', 'email', 'name', 'rosterId'
          ])
        );

      allow delete: if isAdmin();
    }

    // =========================================================
    // CONFIG
    // =========================================================

    match /config/admins {
      allow read: if isSignedIn();
      // Only an admin may change privilege configuration.
      allow create, update, delete: if isAdmin();
    }

    match /config/teachers {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /config/roster {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // =========================================================
    // SUBMISSIONS
    // =========================================================

    match /submissions/{submissionId} {

      // Read only own submissions unless staff.
      allow get: if isSignedIn()
        && (
          isStaff()
          || (
            resource.data.uid == request.auth.uid
            && submissionId.matches('^' + request.auth.uid + '_.*')
          )
        );

      allow list: if isSignedIn()
        && (
          isStaff()
          || resource.data.uid == request.auth.uid
        );

      // Submission ID is bound to the authenticated user + date + set.
      // Score fields are validated server-side by Rules, but this is not
      // equivalent to trusted server-side grading.
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && submissionId == request.auth.uid + '_' +
          request.resource.data.date + '_' + request.resource.data.setId
        && request.resource.data.date is string
        && request.resource.data.date.matches('^\d{4}-\d{2}-\d{2}$')
        && request.resource.data.setId is string
        && request.resource.data.setId.size() > 0
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.total == 20
        && request.resource.data.passed is bool
        && request.resource.data.bonusPoints is int
        && request.resource.data.bonusPoints in [0, 2]
        && request.resource.data.streakAtSubmission is int
        && request.resource.data.streakAtSubmission >= 0
        && request.resource.data.name is string
        && request.resource.data.className is string
        && request.resource.data.submittedAt is timestamp;

      // An already accepted result cannot be edited by the client.
      allow update, delete: if false;
    }

    // =========================================================
    // DAILY SETS / CONTENT
    // =========================================================

    match /sets/{setId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /knowledge/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /questionBank/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    match /listeningContent/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isStaff();
    }

    // =========================================================
    // AUDIT / RATE LIMITS
    // =========================================================

    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /rate_limits/{id} {
      allow read, create, update, delete: if isAdmin();
    }

    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
