rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in ['admin', 'teacher'];
    }

    function isAdmin() {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      allow read: if isOwner(uid) || isStaff();

      allow create: if isOwner(uid);

      allow update: if isStaff()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'className',
            'rosterId',
            'email',
            'lastLoginAt',
            'streak',
            'lastCompletedDate',
            'totalSetsCompleted',
            'totalBonusPoints'
          ])
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // PERSONAL NOTES
    // =========================================================

    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if isOwner(uid);
    }


    // =========================================================
    // ROSTER MAPPING
    // =========================================================

    match /users_by_roster/{rosterId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && (
          request.auth.uid == request.resource.data.uid
          || !exists(
            /databases/$(database)/documents/users_by_roster/$(rosterId)
          )
        );

      allow update: if isSignedIn()
        && (
          request.auth.uid == request.resource.data.uid
          || isStaff()
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // CONFIG
    // =========================================================

    match /config/admins {

      // roles.js đọc khi mọi user login
      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    match /config/teachers {

      // roles.js đọc khi mọi user login
      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    match /config/roster {

      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // SUBMISSIONS
    // =========================================================

    match /submissions/{submissionId} {

      /*
       * QUAN TRỌNG:
       *
       * openSet() dùng getDoc() để kiểm tra:
       *
       *   uid_date_setId
       *
       * Nếu học sinh CHƯA làm set:
       *   document chưa tồn tại.
       *
       * Khi đó resource.data không tồn tại, nên không thể
       * chỉ dùng resource.data.uid để cấp quyền.
       *
       * Cho phép đọc "document không tồn tại" chỉ khi ID
       * thuộc về chính UID đang đăng nhập.
       */

      allow read: if isSignedIn()
        && (
          isStaff()

          || (
            !exists(
              /databases/$(database)/documents/submissions/$(submissionId)
            )
            && submissionId.matches(
              '^' + request.auth.uid + '_.*'
            )
          )

          || (
            exists(
              /databases/$(database)/documents/submissions/$(submissionId)
            )
            && resource.data.uid == request.auth.uid
          )
        );


      // Tạo submission của chính mình
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;


      // Update submission của chính mình
      allow update: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && resource.data.uid == request.auth.uid;


      // Chỉ admin được xóa
      allow delete: if isAdmin();
    }


    // =========================================================
    // DAILY SET
    // =========================================================

    match /sets/{setId} {

      // Student/admin/teacher đều đọc set đã publish
      allow read: if isSignedIn()
        && resource.data.published == true;

      // Chỉ staff ghi
      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // KNOWLEDGE
    // =========================================================

    match /knowledge/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // QUESTION BANK
    // =========================================================

    match /questionBank/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // LISTENING CONTENT
    // =========================================================

    match /listeningContent/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // AUDIT
    // =========================================================

    match /audit/{auditId} {

      allow read: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // RATE LIMITS
    // =========================================================

    match /rate_limits/{id} {

      allow read, create, update, delete: if isAdmin();
    }
  }
}