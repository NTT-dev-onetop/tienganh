rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in ['admin', 'teacher'];
    }

    function isAdmin() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      allow read: if isOwner(uid) || isStaff();

      allow create: if isOwner(uid);

      allow update: if isStaff()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'className',
            'rosterId',
            'email',
            'lastLoginAt',
            'streak',
            'lastCompletedDate',
            'totalSetsCompleted',
            'totalBonusPoints'
          ])
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // ENGLISH NOTES
    // =========================================================

    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if isOwner(uid);
    }


    // =========================================================
    // ROSTER
    // =========================================================

    match /users_by_roster/{rosterId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isStaff()
        || (
          isSignedIn()
          && request.resource.data.uid == request.auth.uid
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // CONFIG
    // =========================================================

    match /config/admins {

      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    match /config/teachers {

      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    match /config/roster {

      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // SUBMISSIONS
    // =========================================================

    match /submissions/{docId} {

      /*
       * QUAN TRỌNG:
       *
       * daily-set.js chạy:
       *
       * query(
       *   collection(db, 'submissions'),
       *   where('uid', '==', currentUser.uid)
       * )
       *
       * Vì vậy student phải được phép đọc submission
       * có uid đúng bằng UID hiện tại.
       */

      allow read: if isSignedIn()
        && (
          request.auth.uid == resource.data.uid
          || isStaff()
        );


      /*
       * Student tạo submission của chính mình.
       *
       * Không ép format ID ở Rules nữa vì JS đã tự tạo:
       *
       * UID_DATE_SETID
       *
       * Việc ép chuỗi ID ở Rules không cần thiết cho
       * quyền Firestore và có thể làm create bị deny
       * nếu kiểu dữ liệu khác dự kiến.
       */

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.uid;


      /*
       * Cho phép chính chủ update submission của chính mình.
       */
      allow update: if isSignedIn()
        && request.auth.uid == resource.data.uid
        && request.resource.data.uid == request.auth.uid;


      // Chỉ admin được xoá
      allow delete: if isAdmin();
    }


    // =========================================================
    // DAILY SETS
    // =========================================================

    match /sets/{setId} {

      // Student chỉ đọc set đã publish
      allow read: if isSignedIn()
        && resource.data.published == true;

      // Chỉ admin/teacher ghi
      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // KNOWLEDGE
    // =========================================================

    match /knowledge/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // QUESTION BANK
    // =========================================================

    match /questionBank/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // LISTENING CONTENT
    // =========================================================

    match /listeningContent/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // AUDIT
    // =========================================================

    match /audit/{auditId} {

      allow read: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // RATE LIMITS
    // =========================================================

    match /rate_limits/{id} {

      allow read, create, update, delete: if isAdmin();
    }
  }
}