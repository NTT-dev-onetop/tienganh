rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in ['admin', 'teacher'];
    }

    function isAdmin() {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      allow read: if isOwner(uid) || isStaff();

      allow create: if isOwner(uid);

      allow update: if isStaff()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'className',
            'rosterId',
            'email',
            'lastLoginAt',
            'streak',
            'lastCompletedDate',
            'totalSetsCompleted',
            'totalBonusPoints'
          ])
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // ENGLISH NOTES
    // =========================================================

    match /users/{uid}/english_notes/{noteId} {

      allow read, create, update, delete: if isOwner(uid);
    }


    // =========================================================
    // ROSTER
    // =========================================================

    match /users_by_roster/{rosterId} {

      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if isStaff()
        || (
          isSignedIn()
          && request.resource.data.uid == request.auth.uid
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // CONFIG
    // =========================================================

    match /config/admins {

      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    match /config/teachers {

      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    match /config/roster {

      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // SUBMISSIONS
    // =========================================================

    match /submissions/{submissionId} {

      /*
       * GET
       *
       * daily-set.js có:
       *
       * getDoc(
       *   doc(db, 'submissions',
       *   `${currentUser.uid}_${date}_${id}`)
       * )
       *
       * Khi chưa làm bài, document chưa tồn tại.
       *
       * Vì vậy không được chỉ dựa vào resource.data.uid.
       *
       * ID submission của học sinh luôn bắt đầu bằng UID của
       * chính học sinh đó.
       */

      allow get: if isSignedIn()
        && (
          isStaff()
          || submissionId.matches(
            '^' + request.auth.uid + '_.*'
          )
        );


      /*
       * LIST / QUERY
       *
       * daily-set.js:
       *
       * query(
       *   collection(db, 'submissions'),
       *   where('uid', '==', currentUser.uid)
       * )
       *
       * Student chỉ được query submission của chính mình.
       *
       * Staff được query tất cả.
       */

      allow list: if isSignedIn()
        && (
          isStaff()
          || resource.data.uid == request.auth.uid
        );


      /*
       * CREATE
       *
       * Student chỉ được tạo submission của chính mình.
       */

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;


      /*
       * UPDATE
       *
       * Student chỉ được sửa submission của chính mình.
       */

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;


      /*
       * DELETE
       */

      allow delete: if isAdmin();
    }


    // =========================================================
    // DAILY SETS
    // =========================================================

    match /sets/{setId} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // KNOWLEDGE
    // =========================================================

    match /knowledge/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // QUESTION BANK
    // =========================================================

    match /questionBank/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // LISTENING CONTENT
    // =========================================================

    match /listeningContent/{id} {

      allow read: if isSignedIn()
        && resource.data.published == true;

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // AUDIT
    // =========================================================

    match /audit/{auditId} {

      allow read: if isAdmin();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    // =========================================================
    // RATE LIMITS
    // =========================================================

    match /rate_limits/{id} {

      allow read, create, update, delete: if isAdmin();
    }
  }
}