rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isStaff() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in ['admin', 'teacher'];
    }

    // ---------------------------------------------------------
    // USERS
    // ---------------------------------------------------------
    match /users/{uid} {

      // Chính chủ hoặc admin/teacher
      allow read: if isOwner(uid) || isStaff();

      // User tự tạo hồ sơ của chính mình
      allow create: if isOwner(uid);

      // Student chỉ được sửa các field cho phép.
      // role bắt buộc giữ nguyên.
      allow update: if isStaff()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'className',
            'rosterId',
            'email',
            'lastLoginAt',
            'streak',
            'lastCompletedDate',
            'totalSetsCompleted',
            'totalBonusPoints'
          ])
        );

      // Chỉ admin được xoá user
      allow delete: if isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // ---------------------------------------------------------
    // PERSONAL ENGLISH NOTES
    // ---------------------------------------------------------
    match /users/{uid}/english_notes/{noteId} {

      // Chỉ chính chủ
      allow read, create, update, delete: if isOwner(uid);
    }


    // ---------------------------------------------------------
    // USERS BY ROSTER
    // ---------------------------------------------------------
    match /users_by_roster/{rosterId} {

      // Tất cả user đăng nhập được đọc mapping
      allow read: if isSignedIn();

      // Cho phép:
      // 1. UID hiện tại tạo mapping của chính mình
      // 2. rosterId chưa tồn tại
      allow create: if isSignedIn()
        && (
          request.auth.uid == request.resource.data.uid
          || !exists(
            /databases/$(database)/documents/users_by_roster/$(rosterId)
          )
        );

      // Chính chủ hoặc staff được update
      allow update: if isStaff()
        || (
          isSignedIn()
          && request.auth.uid == request.resource.data.uid
        );

      // Chỉ admin xoá mapping
      allow delete: if isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // ---------------------------------------------------------
    // CONFIG
    // ---------------------------------------------------------

    match /config/admins {

      // roles.js cần đọc khi login
      allow read: if isSignedIn();

      // Chỉ admin sửa danh sách admin
      allow create, update, delete: if isStaff();
    }


    match /config/teachers {

      // roles.js cần đọc khi login
      allow read: if isSignedIn();

      // Chỉ admin/teacher sửa danh sách teacher
      allow create, update, delete: if isStaff();
    }


    match /config/roster {

      // roster gate cần đọc
      allow read: if isSignedIn();

      // Staff quản lý roster
      allow create, update, delete: if isStaff();
    }


    // ---------------------------------------------------------
    // DAILY SET SUBMISSIONS
    // ---------------------------------------------------------
    match /submissions/{docId} {

      // Chính chủ hoặc staff được đọc
      allow read: if isSignedIn()
        && (
          request.auth.uid == resource.data.uid
          || isStaff()
        );

      // Student tạo submission của chính mình
      // Staff cũng được tạo nếu uid trong document là chính họ.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.uid;

      // Student được update submission của chính mình
      allow update: if isSignedIn()
        && request.auth.uid == request.resource.data.uid;

      // Chỉ admin xoá
      allow delete: if isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // ---------------------------------------------------------
    // DAILY SETS
    // ---------------------------------------------------------
    match /sets/{setId} {

      // Student + teacher + admin đều đọc được
      // nhưng chỉ set đã publish.
      allow read: if isSignedIn()
        && resource.data.published == true;

      // Chỉ staff ghi/xoá
      allow create, update, delete: if isStaff();
    }


    // ---------------------------------------------------------
    // KNOWLEDGE
    // ---------------------------------------------------------
    match /knowledge/{id} {

      // User đăng nhập đọc nội dung đã publish
      allow read: if isSignedIn()
        && resource.data.published == true;

      // Staff quản lý
      allow create, update, delete: if isStaff();
    }


    // ---------------------------------------------------------
    // QUESTION BANK
    // ---------------------------------------------------------
    match /questionBank/{id} {

      // User đăng nhập đọc câu hỏi đã publish
      allow read: if isSignedIn()
        && resource.data.published == true;

      // Staff quản lý
      allow create, update, delete: if isStaff();
    }


    // ---------------------------------------------------------
    // LISTENING CONTENT
    // ---------------------------------------------------------
    match /listeningContent/{id} {

      // User đăng nhập đọc nội dung đã publish
      allow read: if isSignedIn()
        && resource.data.published == true;

      // Staff quản lý
      allow create, update, delete: if isStaff();
    }


    // ---------------------------------------------------------
    // AUDIT
    // ---------------------------------------------------------
    match /audit/{auditId} {

      allow read: if isStaff();

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update, delete: if isStaff();
    }


    // ---------------------------------------------------------
    // RATE LIMITS
    // ---------------------------------------------------------
    match /rate_limits/{id} {

      allow read, create, update, delete: if isStaff();
    }
  }
}