rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    function bootstrapAdmin() { return signedIn() && email() == 'icloud07072010@gmail.com'; }
    function adminConfigExists() { return exists(/databases/$(database)/documents/config/admins); }
    function adminConfig() { return get(/databases/$(database)/documents/config/admins); }
    function isAdmin() {
      return signedIn() && (bootstrapAdmin() || (adminConfigExists() && adminConfig().data.emails is list && email() in adminConfig().data.emails));
    }
    function sameUser(uid) { return signedIn() && request.auth.uid == uid; }
    function validRole(role) { return role == 'admin' || role == 'teacher' || role == 'student'; }
    function owner() { return signedIn() && email() == 'icloud07072010@gmail.com'; }
    function teacherConfigExists() { return exists(/databases/$(database)/documents/config/teachers); }
    function teacherConfig() { return get(/databases/$(database)/documents/config/teachers); }
    function isTeacher() { return signedIn() && !isAdmin() && teacherConfigExists() && teacherConfig().data.emails is list && email() in teacherConfig().data.emails; }
    function isStaff() { return isAdmin() || isTeacher(); }
    function userEmailCanStayOrBootstrap() {
      return !(resource.data.email is string)
        ? request.resource.data.email == email()
        : request.resource.data.email == resource.data.email;
    }
    function userRoleCanStayOrBootstrapStudent() {
      return !(resource.data.role is string)
        ? request.resource.data.role == 'student'
        : request.resource.data.role == resource.data.role;
    }

    match /config/admins {
      // Only admins and listed admins can inspect the admin allowlist.
      allow read: if owner() || (signedIn() && resource.data.emails is list && email() in resource.data.emails);
      allow create, update: if owner() && request.resource.data.emails is list;

      allow delete: if owner();
    }

    match /config/teachers {
      // A teacher can verify their own membership; students cannot enumerate staff emails.
      allow read: if isAdmin() || (signedIn() && resource.data.emails is list && email() in resource.data.emails);
      allow create, update, delete: if isAdmin();
    }

    match /config/roster {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if sameUser(uid) || isStaff();
      // Người dùng mới luôn được phép tạo hồ sơ của chính mình.
      // Student không phụ thuộc vào config/admins. Admin chỉ được bootstrap bằng Gmail
      // hoặc bằng email đã có trong config/admins.
      allow create: if sameUser(uid)
        && validRole(request.resource.data.role)
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && request.resource.data.className is string
        && (
          request.resource.data.role == 'student'
          || (request.resource.data.role == 'admin' && isAdmin())
          || (request.resource.data.role == 'teacher' && isAdmin())
        );
      allow update: if (
          isAdmin()
          && request.resource.data.email == resource.data.email
          && validRole(request.resource.data.role)
        ) || (
          sameUser(uid)
          && userEmailCanStayOrBootstrap()
          && userRoleCanStayOrBootstrapStudent()
          && validRole(request.resource.data.role)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'email','lastLoginAt','name','className','rosterId','teacherLabel','teacherEmail',
            'streak','lastCompletedDate','totalSetsCompleted','totalBonusPoints'
          ])
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rosterId','className'])
            || (
              (!(resource.data.rosterId is string) || resource.data.rosterId == '')
              && request.resource.data.rosterId is string
              && exists(/databases/$(database)/documents/users_by_roster/$(request.resource.data.rosterId))
              && get(/databases/$(database)/documents/users_by_roster/$(request.resource.data.rosterId)).data.uid == uid
            )
          )
        );
      allow delete: if isAdmin();
    }

    match /users_by_roster/{rosterId} {
      allow read: if isAdmin() || resource == null || sameUser(resource.data.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rosterId == rosterId
        && request.resource.data.email == email()
        && request.resource.data.name is string
        && !exists(/databases/$(database)/documents/users_by_roster/$(rosterId));
      allow update: if isAdmin() || (
        sameUser(resource.data.uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.rosterId == resource.data.rosterId
        && request.resource.data.email == email()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','name'])
      );
      allow delete: if isAdmin();
    }


    match /knowledge/{knowledgeId} {
      allow read: if signedIn() && resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /questionBank/{questionId} {
      allow read: if signedIn() && resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /listeningContent/{listeningId} {
      allow read: if signedIn() && resource.data.published == true || isStaff();
      allow create, update, delete: if isStaff();
    }

    match /sets/{setId} {
      allow read: if signedIn();
      allow create, update, delete: if isStaff();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (resource == null || resource.data.uid == request.auth.uid || isStaff());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.setId is string
        && request.resource.data.setId.size() > 0
        && submissionId == request.auth.uid + '_' + request.resource.data.date + '_' + request.resource.data.setId
        && request.resource.data.total == 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.passed == (request.resource.data.score >= 15)
        && request.resource.data.bonusPoints is int
        && request.resource.data.bonusPoints >= 0
        && request.resource.data.bonusPoints <= 2
        && request.resource.data.date is string
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0;
      allow update, delete: if isAdmin();
    }

    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if sameUser(uid);
    }

    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /rate_limits/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
