rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // HELPERS
    // =========================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn()
        && request.auth.uid == uid;
    }

    function isStaff() {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role in ['admin', 'teacher'];
    }

    function isAdmin() {
      return isSignedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{uid} {

      // User đọc chính mình, staff đọc user
      allow read: if isOwner(uid) || isStaff();

      // User tạo tài khoản của chính mình
      allow create: if isOwner(uid);

      // Staff được cập nhật
      // User chỉ được cập nhật các field được phép
      allow update: if isStaff()
        || (
          isOwner(uid)
          && request.resource.data.role == resource.data.role
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'className',
            'rosterId',
            'email',
            'lastLoginAt',
            'streak',
            'lastCompletedDate',
            'totalSetsCompleted',
            'totalBonusPoints'
          ])
        );

      // Chỉ admin xóa user
      allow delete: if isAdmin();
    }


    // =========================================================
    // ENGLISH NOTES
    // =========================================================

    match /users/{uid}/english_notes/{noteId} {

      allow read, create, update, delete: if isOwner(uid);
    }


    // =========================================================
    // USERS BY ROSTER
    // =========================================================

    match /users_by_roster/{rosterId} {

      // User đăng nhập được đọc
      allow read: if isSignedIn();

      // User tạo mapping của chính mình
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      // Staff hoặc chính chủ được cập nhật
      allow update: if isStaff()
        || (
          isSignedIn()
          && request.resource.data.uid == request.auth.uid
        );

      // Chỉ admin xóa
      allow delete: if isAdmin();
    }


    // =========================================================
    // CONFIG - ADMINS
    // =========================================================

    match /config/admins {

      // roles.js cần đọc khi đăng nhập
      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // CONFIG - TEACHERS
    // =========================================================

    match /config/teachers {

      // roles.js cần đọc khi đăng nhập
      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // CONFIG - ROSTER
    // =========================================================

    match /config/roster {

      allow read: if isSignedIn();

      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // SUBMISSIONS
    // =========================================================

    match /submissions/{submissionId} {

      /*
       * GET
       *
       * daily-set.js dùng:
       *
       * getDoc(
       *   doc(
       *     db,
       *     'submissions',
       *     `${currentUser.uid}_${date}_${id}`
       *   )
       * )
       *
       * Nếu học sinh chưa làm bài thì document chưa tồn tại.
       *
       * Vì vậy get không thể chỉ dựa vào resource.data.uid.
       */

      allow get: if isSignedIn()
        && (
          isStaff()
          || submissionId.matches(
            '^' + request.auth.uid + '_.*'
          )
        );


      /*
       * LIST
       *
       * daily-set.js dùng:
       *
       * query(
       *   collection(db, 'submissions'),
       *   where('uid', '==', currentUser.uid)
       * )
       *
       * Student chỉ được đọc submission của chính mình.
       *
       * Staff được đọc.
       */

      allow list: if isSignedIn()
        && (
          isStaff()
          || resource.data.uid == request.auth.uid
        );


      /*
       * CREATE
       *
       * Student chỉ tạo submission của chính mình.
       */

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;


      /*
       * UPDATE
       *
       * Student chỉ sửa submission của chính mình.
       */

      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;


      /*
       * DELETE
       *
       * Chỉ admin.
       */

      allow delete: if isAdmin();
    }


    // =========================================================
    // DAILY SETS
    // =========================================================

    match /sets/{setId} {

      /*
       * Student/admin/teacher đều được đọc Daily Set.
       *
       * Không kiểm tra published ở Rules vì code hiện tại
       * của app đã lọc published == true khi query.
       *
       * Điều này tránh lỗi:
       * "Không tải được Daily Set"
       * khi document cũ thiếu field published.
       */

      allow read: if isSignedIn();

      // Chỉ admin/teacher được ghi
      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // KNOWLEDGE
    // =========================================================

    match /knowledge/{id} {

      /*
       * Cho phép user đã đăng nhập đọc kiến thức.
       *
       * Không ép published == true ở Rules để tránh query
       * bị Permission Denied với dữ liệu cũ.
       */

      allow read: if isSignedIn();

      // Chỉ admin/teacher được ghi
      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // QUESTION BANK
    // =========================================================

    match /questionBank/{id} {

      /*
       * Cho phép user đã đăng nhập đọc ngân hàng câu hỏi.
       */

      allow read: if isSignedIn();

      // Chỉ admin/teacher được ghi
      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // LISTENING CONTENT
    // =========================================================

    match /listeningContent/{id} {

      /*
       * Cho phép user đã đăng nhập đọc Listening.
       */

      allow read: if isSignedIn();

      // Chỉ admin/teacher được ghi
      allow create, update, delete: if isStaff();
    }


    // =========================================================
    // AUDIT
    // =========================================================

    match /audit/{auditId} {

      // Chỉ admin đọc audit
      allow read: if isAdmin();

      // User chỉ tạo audit của chính mình
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;

      // Chỉ admin sửa/xóa
      allow update, delete: if isAdmin();
    }


    // =========================================================
    // RATE LIMITS
    // =========================================================

    match /rate_limits/{id} {

      // Chỉ admin
      allow read, create, update, delete: if isAdmin();
    }
  }
}