rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function email() { return signedIn() && request.auth.token.email != null ? request.auth.token.email.lower() : ''; }
    function bootstrapAdmin() { return signedIn() && email() == 'icloud07072010@gmail.com'; }
    function adminConfigExists() { return exists(/databases/$(database)/documents/config/admins); }
    function adminConfig() { return get(/databases/$(database)/documents/config/admins); }
    function isAdmin() {
      return signedIn() && (bootstrapAdmin() || (adminConfigExists() && adminConfig().data.emails is list && email() in adminConfig().data.emails));
    }
    function sameUser(uid) { return signedIn() && request.auth.uid == uid; }
    function validRole(role) { return role == 'admin' || role == 'student'; }

    match /config/admins {
      allow read: if signedIn();
      allow create: if bootstrapAdmin();
      allow update, delete: if isAdmin();
    }

    match /config/roster {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if sameUser(uid) || isAdmin();
      allow create: if sameUser(uid)
        && validRole(request.resource.data.role)
        && request.resource.data.role == (isAdmin() ? 'admin' : 'student');
      allow update: if sameUser(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email;
      allow delete: if isAdmin();
    }

    match /users_by_roster/{rosterId} {
      allow read: if sameUser(resource.data.uid) || isAdmin();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rosterId == rosterId
        && !exists(/databases/$(database)/documents/users_by_roster/$(rosterId));
      allow update: if isAdmin() || (sameUser(resource.data.uid) && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }


    match /knowledge/{knowledgeId} {
      allow read: if signedIn() && resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /questionBank/{questionId} {
      allow read: if signedIn() && resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /listeningContent/{listeningId} {
      allow read: if signedIn() && resource.data.published == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /sets/{setId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.total == 20
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 20
        && request.resource.data.passed == (request.resource.data.score >= 15)
        && request.resource.data.bonusPoints == (request.resource.data.passed ? 2 : 0)
        && request.resource.data.date is string
        && request.resource.data.signature is string
        && request.resource.data.signature.size() > 0;
      allow update, delete: if isAdmin();
    }

    match /users/{uid}/english_notes/{noteId} {
      allow read, create, update, delete: if sameUser(uid);
    }

    match /audit/{auditId} {
      allow read: if isAdmin();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /rate_limits/{id} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
