rules_version = '2';

service cloud.firestore {
match /databases/{database}/documents {

// =========================================================
// HELPERS
// =========================================================

function isSignedIn() {
  return request.auth != null;
}

function isOwner(uid) {
  return isSignedIn()
    && request.auth.uid == uid;
}

function isStaff() {
  return isSignedIn()
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.role in ['admin', 'teacher'];
}

function isAdmin() {
  return isSignedIn()
    && get(
      /databases/$(database)/documents/users/$(request.auth.uid)
    ).data.role == 'admin';
}


// =========================================================
// USERS
// =========================================================

match /users/{uid} {

  allow read: if isOwner(uid) || isStaff();

  allow create: if isOwner(uid);

  allow update: if isStaff()
    || (
      isOwner(uid)
      && request.resource.data.role == resource.data.role
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'className',
        'rosterId',
        'email',
        'lastLoginAt',
        'streak',
        'lastCompletedDate',
        'totalSetsCompleted',
        'totalBonusPoints'
      ])
    );

  allow delete: if isAdmin();
}


// =========================================================
// ENGLISH NOTES
// =========================================================

match /users/{uid}/english_notes/{noteId} {

  allow read, create, update, delete: if isOwner(uid);
}


// =========================================================
// USERS BY ROSTER
// =========================================================

match /users_by_roster/{rosterId} {

  allow read: if isSignedIn();

  allow create: if isSignedIn()
    && request.resource.data.uid == request.auth.uid;

  allow update: if isStaff()
    || (
      isSignedIn()
      && request.resource.data.uid == request.auth.uid
    );

  allow delete: if isAdmin();
}


// =========================================================
// CONFIG - ADMINS
// =========================================================

match /config/admins {

  allow read: if isSignedIn();

  allow create, update, delete: if isStaff();
}


// =========================================================
// CONFIG - TEACHERS
// =========================================================

match /config/teachers {

  allow read: if isSignedIn();

  allow create, update, delete: if isStaff();
}


// =========================================================
// CONFIG - ROSTER
// =========================================================

match /config/roster {

  allow read: if isSignedIn();

  allow create, update, delete: if isStaff();
}


// =========================================================
// SUBMISSIONS
// =========================================================

match /submissions/{submissionId} {

  // getDoc() submission của chính mình.
  // Cho phép cả trường hợp document chưa tồn tại,
  // vì ID được tạo theo UID_date_setId.

  allow get: if isSignedIn()
    && (
      isStaff()
      || submissionId.matches(
        '^' + request.auth.uid + '_.*'
      )
    );


  // query submissions của chính mình.
  // daily-set.js dùng:
  // where('uid', '==', currentUser.uid)

  allow list: if isSignedIn()
    && (
      isStaff()
      || resource.data.uid == request.auth.uid
    );


  // =======================================================
  // CREATE SUBMISSION
  // =======================================================
  //
  // Một học sinh có thể nộp nhiều Daily Set trong cùng ngày.
  //
  // Ví dụ:
  // uid_date_set1
  // uid_date_set2
  //
  // Daily 1 KHÔNG khóa Daily 2.
  //
  // Không kiểm tra totalQuestions/passScore bằng get()
  // vì Daily Set có thể được cấu hình số câu riêng.
  // =======================================================

  allow create: if isSignedIn()

    // Chỉ được nộp bài của chính mình
    && request.resource.data.uid == request.auth.uid

    // Các field bắt buộc
    && request.resource.data.setId is string
    && request.resource.data.date is string
    && request.resource.data.score is int
    && request.resource.data.total is int
    && request.resource.data.passScore is int
    && request.resource.data.passed is bool

    // Điểm hợp lệ
    && request.resource.data.score >= 0
    && request.resource.data.total > 0
    && request.resource.data.score <= request.resource.data.total

    // passScore hợp lệ
    && request.resource.data.passScore > 0
    && request.resource.data.passScore <= request.resource.data.total

    // passed phải đúng với score/passScore
    && request.resource.data.passed == (
      request.resource.data.score >= request.resource.data.passScore
    );


  // Submission đã nộp thì không được sửa
  allow update: if false;


  // Chỉ admin được xóa submission
  allow delete: if isAdmin();
}


// =========================================================
// DAILY SETS
// =========================================================

match /sets/{setId} {

  // User đã đăng nhập được đọc Daily Set.
  // daily-set.js tự xử lý published/schedule/unlock.

  allow read: if isSignedIn();

  // Admin / teacher được quản lý Daily Set

  allow create, update, delete: if isStaff();
}


// =========================================================
// KNOWLEDGE
// =========================================================

match /knowledge/{id} {

  // User đã đăng nhập được đọc kiến thức.

  allow read: if isSignedIn();

  // Admin / teacher được quản lý kiến thức

  allow create, update, delete: if isStaff();
}


// =========================================================
// QUESTION BANK
// =========================================================

match /questionBank/{id} {

  // User đã đăng nhập được đọc ngân hàng câu hỏi

  allow read: if isSignedIn();

  // Admin / teacher được quản lý ngân hàng câu hỏi

  allow create, update, delete: if isStaff();
}


// =========================================================
// LISTENING CONTENT
// =========================================================

match /listeningContent/{id} {

  // User đã đăng nhập được đọc Listening

  allow read: if isSignedIn();

  // Admin / teacher được quản lý Listening

  allow create, update, delete: if isStaff();
}


// =========================================================
// AUDIT
// =========================================================

match /audit/{auditId} {

  allow read: if isAdmin();

  allow create: if isSignedIn()
    && request.resource.data.uid == request.auth.uid;

  allow update, delete: if isAdmin();
}


// =========================================================
// RATE LIMITS
// =========================================================

match /rate_limits/{id} {

  allow read, create, update, delete: if isAdmin();
}


}
}
